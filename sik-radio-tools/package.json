{
  "name": "sik-radio-tools",
  "version": "1.0.1",
  "description": "SiK telemetry radio configurator — web (Web Serial) and desktop (Tauri native serial)",
  "private": true,
  "scripts": {
    "build": "tsc && npm run copy-assets",
    "build:desktop": "npm run build && node scripts/prepare-desktop.js",
    "copy-assets": "node scripts/copy-assets.js",
    "watch": "tsc -w",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "jimp": "^1.6.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  }
}
